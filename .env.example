# --- LLM provider (OpenAI-compatible). Leave LLM_API_KEY empty to run fully
# --- offline with a deterministic mock model (great for demos / CI).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Set to "mock" to force the offline deterministic model even if a key is set.
LLM_PROVIDER=auto

# --- Embeddings. Empty => offline deterministic hashing embeddings.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# --- Redis cache (optional). If unreachable, falls back to in-memory cache.
REDIS_URL=redis://localhost:6379/0

# --- Data sources
WORKLOGS_DIR=sample_data/worklogs
KNOWLEDGE_BASE_DIR=sample_data/knowledge_base
GIT_REPO_PATH=.

APP_ENV=dev
LOG_LEVEL=INFO
